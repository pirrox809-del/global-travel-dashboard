// =====================================================================
// Global Travel Dashboard — Prisma Schema
// ---------------------------------------------------------------------
// Design rationale:
//  - `Country` holds *stable* metadata (codes, capital, coords, flag...).
//  - `CountryContent` stores LLM-generated, curated rich text that rarely
//    changes (overview, culture, unwritten rules). Generated once on first
//    request, then persisted forever (acts as a permanent cache layer).
//  - `Food` and `PointOfInterest` are 1:N relational tables (normalized)
//    so we can query / paginate them independently.
//  - `TravelPriceEstimate` holds *regional* price ranges for hotels/flights
//    generated by the LLM (no truly free live API exists). Stored once per
//    country and refreshed on demand.
//  - SQLite is used here for the sandbox; in production this maps 1:1 to
//    PostgreSQL by just switching the datasource provider.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Core country metadata (sourced from REST Countries API, cached permanently).
model Country {
  id               String   @id @default(cuid())
  /// ISO 3166-1 alpha-2 code, e.g. "FR" — the canonical key for joins & API.
  code             String   @unique
  /// ISO 3166-1 alpha-3 code, e.g. "FRA".
  code3            String?
  /// Common name in English, e.g. "France".
  name             String
  /// Official name, e.g. "French Republic".
  officialName     String?
  capital          String?
  region           String?
  subregion        String?
  /// Independent flag (boolean) — useful for territories.
  independent      Boolean?
  /// UN member state flag.
  unMember         Boolean?
  /// JSON-stringified array of language codes -> names, e.g. {"fra":"French"}.
  languagesJson    String?
  /// JSON-stringified map of currency code -> {name, symbol}.
  currenciesJson   String?
  /// JSON-stringified array of calling codes, e.g. ["+33"].
  callingCodesJson String?
  /// JSON-stringified array of IANA timezones, e.g. ["Europe/Paris"].
  timezonesJson    String?
  /// Latitude of capital (used for weather lookups).
  latitude         Float?
  /// Longitude of capital.
  longitude        Float?
  /// Area in km².
  area             Float?
  /// Population estimate.
  population       BigInt?
  /// Emoji flag, e.g. "🇫🇷".
  flagEmoji        String?
  /// URL of SVG/PNG flag.
  flagUrl          String?
  /// Wikimedia Commons / Wikipedia page title for further enrichment.
  wikiName         String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  content          CountryContent?
  foods            Food[]
  pois              PointOfInterest[]
  priceEstimate    TravelPriceEstimate?

  @@index([region])
  @@index([name])
}

/// LLM-generated, curated long-form content for a country (overview, culture,
/// unwritten rules). Generated lazily on first request and then cached in DB.
model CountryContent {
  id              String   @id @default(cuid())
  countryCode     String   @unique
  country         Country  @relation(fields: [countryCode], references: [code], onDelete: Cascade)

  /// ~250-word high-level overview of the country.
  overview        String
  /// Markdown bullet list of cultural notes (language, religion, etiquette...).
  culture         String
  /// Markdown bullet list of "unwritten rules" / etiquette / taboos.
  unwrittenRules  String
  /// LLM-generated general safety brief (used as fallback when the live
  /// US State Dept advisory API is unreachable). Plain text paragraph.
  safetyBrief     String?
  /// ISO 639-1 language code the content was generated in (en/es/it/fr).
  contentLanguage String? @default("en")
  /// JSON: emergency numbers {police, ambulance, fire, general}.
  emergencyNumbersJson String?
  /// Paragraph on crime risks, scams, areas to avoid.
  crimeBrief      String?
  /// JSON array of dangerous animals [{name, description}].
  dangerousAnimalsJson String?
  /// Paragraph on quality of life (healthcare, safety, cost of living).
  qualityOfLife   String?
  /// JSON: tax summary {vatRate, corporateTax, incomeTax, notes}.
  taxesJson       String?
  /// Paragraph on recommended clothing by season.
  clothingAdvice  String?
  /// Paragraph on internet quality (fiber/5G coverage, rural vs urban).
  internetQuality String?
  /// Paragraph on natural disaster risk (tsunamis, hurricanes, monsoons, volcanoes).
  naturalDisasterRisk String?
  /// JSON array of TV channels [{name, type}].
  tvChannelsJson  String?
  /// JSON array of famous people [{name, profession}].
  famousPeopleJson String?
  /// Short tagline, e.g. "The Hexagon of gastronomy and art de vivre".
  tagline         String?
  /// Best months to visit, e.g. "Apr–Jun, Sep–Oct".
  bestTimeToVisit String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Typical / signature dishes of a country.
model Food {
  id          String   @id @default(cuid())
  countryCode String
  country     Country  @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  name        String
  description String?
  /// e.g. "main", "dessert", "street", "drink".
  category    String?
  /// Optional image URL (Wikimedia Commons).
  imageUrl    String?
  createdAt   DateTime @default(now())

  @@index([countryCode])
}

/// Points of interest / must-see places.
model PointOfInterest {
  id          String   @id @default(cuid())
  countryCode String
  country     Country  @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  name        String
  description String?
  /// e.g. "historic", "nature", "museum", "beach", "religious".
  category    String?
  city        String?
  /// For map rendering / weather lookups.
  latitude    Float?
  longitude   Float?
  imageUrl    String?
  createdAt   DateTime @default(now())

  @@index([countryCode])
  @@index([category])
}

/// Regional price ranges (LLM-generated, refreshed periodically).
/// These are *estimates*, not live booking data — clearly labelled in UI.
model TravelPriceEstimate {
  id              String   @id @default(cuid())
  countryCode     String   @unique
  country         Country  @relation(fields: [countryCode], references: [code], onDelete: Cascade)

  /// Budget per-night hotel range in EUR, e.g. "40–90".
  budgetHotelEur  String
  /// Mid-range per-night hotel range in EUR, e.g. "90–180".
  midHotelEur     String
  /// Luxury per-night hotel range in EUR.
  luxuryHotelEur  String
  /// Estimated round-trip flight from Europe in EUR.
  flightFromEuEur String
  /// Cheap local meal in EUR.
  mealBudgetEur   String
  /// Mid-range restaurant meal in EUR.
  mealMidEur      String
  /// Currency note / purchasing power parity hint.
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
