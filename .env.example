# ─────────────────────────────────────────────────────────────
# Global Travel Dashboard — environment variables template
# Copy this file to `.env` and adjust the values.
# ─────────────────────────────────────────────────────────────

# Prisma / SQLite database location.
# NOTE: the path is resolved relative to prisma/schema.prisma,
# so use ../ to point at the project-root /db folder.
#   Local dev (default):   file:../db/custom.db
#   Railway/Render volume: file:/data/custom.db  (mount a volume)
#   Turso (LibSQL cloud):  switch schema provider to "turso"
#                          and use libsql://<your-db>.turso.io
#                          with DATABASE_URL + DATABASE_AUTH_TOKEN
DATABASE_URL=file:../db/custom.db

# ── Optional: LLM credentials (chat, briefs, on-the-fly translations) ──
# The app looks for credentials in this order:
#
#   1. Environment variables (recommended for Vercel/production):
#        ZAI_BASE_URL   OpenAI-compatible base URL, e.g. https://api.openai.com/v1
#        ZAI_API_KEY    bearer key for that endpoint
#        ZAI_TOKEN      optional — X-Token header (z.ai gateway sessions)
#        ZAI_CHAT_ID    optional — X-Chat-Id header
#        ZAI_USER_ID    optional — X-User-Id header
#        ZAI_MODEL      optional model name (most providers require one)
#
#   2. A `.z-ai-config` JSON file in the project root, home dir, or /etc:
#        { "baseUrl": "https://<openai-compatible-endpoint>", "apiKey": "<key>" }
#
# Without credentials nothing breaks: live data and the pre-seeded briefs
# keep working — only the chatbot and new brief generation are disabled.

# ── Optional: scheduled auto-refresh (Vercel Cron, /api/cron/refresh) ──
# A daily cron regenerates the 2 oldest AI briefs into a disposable DB copy.
#   CRON_SECRET  recommended — Vercel Cron sends it as "Authorization: Bearer".
#   REFRESH_KEY  optional — lets you trigger a manual run with ?key=<value>.
# With GH_TOKEN + GH_REPO set, the refreshed database is committed back to
# the repository, which triggers a redeploy so new briefs go live by themselves.
CRON_SECRET=
REFRESH_KEY=
GH_TOKEN=
GH_REPO=owner/repo
GH_BRANCH=main
